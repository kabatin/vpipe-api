<?xml version="1.0" encoding="UTF-8"?>
<!--
  Run vpipe-api at login.
    cp examples/com.github.kabatin.vpipe-api.plist ~/Library/LaunchAgents/
    # edit the paths below (uv tool installs to ~/.local/bin)
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.github.kabatin.vpipe-api.plist
  Stop:  launchctl bootout gui/$(id -u)/com.github.kabatin.vpipe-api
  Settings come from ~/.config/vpipe-api/config.toml. Put a token there if you bind to a LAN address.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.github.kabatin.vpipe-api</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/.local/bin/vpipe-api</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/vpipe-api.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/vpipe-api.log</string>
</dict>
</plist>
